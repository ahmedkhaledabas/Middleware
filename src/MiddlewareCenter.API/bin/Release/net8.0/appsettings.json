{
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SERVER;Database=MiddlewareCenterDB;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True"
  },
  "ExternalApis": {
    "Coursera": {
      "BaseUrl": "https://YOUR_COURSERA_URL/api"
    },
    "ERP": {
      "BaseUrl": "https://YOUR_ERP_URL/api"
    },
    "K2": {
      "BaseUrl": "https://YOUR_K2_URL/api"
    },
    "ServiceDesk": {
      "BaseUrl": "https://YOUR_SD_URL/api"
    },
    "SharePoint": {
      "BaseUrl": "https://YOUR_SP_URL/api"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:4200"
    ]
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "QueueLimit": 20
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
